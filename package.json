  "keywords": [
    "workbuddy",
    "claude-code",
    "codex",
    "mcp",
    "anthropic",
    "openai",
    "bridge",
    "proxy"
  ],
  "license": "MIT",
  "bin": {
    "workbuddy-bridge": "./http-server.js",
    "workbuddy-bridge-mcp": "./server.js"
  },
  "main": "./http-server.js",
  "files": [
    "http-server.js",
    "responses.js",
    "upstream.js",
    "credentials.js",
    "locate.js",
    "providers.js",
    "server.js",
    "doctor.js",
    "README.md",
    "HTTP-BRIDGE.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node http-server.js",
    "mcp": "node server.js",
    "doctor": "node doctor.js"
  },
  "engines": {
    "node": ">=20.3.0"
  },
  "dependencies": {},
  "optionalDependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  }
